# BENXAUTOMATION Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env or real credentials.

# OpenAI API credentials (for AI topic-to-script generation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: custom base URL for OpenAI-compatible providers (LocalAI, Ollama, vLLM, OpenRouter)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: TTS voice customization
# BENX_DEFAULT_VOICE=en-US-AriaNeural

# Optional: Path to custom FFmpeg binary if not in PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
